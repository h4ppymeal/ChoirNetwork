# Copy to .env and fill in your values:
#   cp .env.example .env

# OpenAI (optional — only needed for --llm-expand / CHOIRNETWORK_LLM_EXPAND=1)
OPENAI_API_KEY=

# LLM model for query expansion (default: gpt-4o-mini — reliable for short text)
# Cheaper option: gpt-5-nano (may need higher token budget; auto-falls back to gpt-4o-mini)
# OPENAI_LLM_MODEL=gpt-4o-mini

# Default for the UI "AI theme refinement" checkbox (0 = off, 1 = on).
# Users can override per search in the web app without restarting.
CHOIRNETWORK_LLM_EXPAND=0

# Curated sermon/Bible topic expansion in the web app (0 = off, 1 = on)
CHOIRNETWORK_EXPAND_QUERIES=1

# Cross-encoder reranking (0 = off, 1 = on)
CHOIRNETWORK_USE_RERANKER=1

# Path to the hymn embedding index
# CHOIRNETWORK_INDEX_PATH=data/index
